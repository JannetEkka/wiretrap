# Google Cloud & Vertex AI Configuration (Workload Identity / ADC from Cloud Run)
GOOGLE_GENAI_USE_VERTEXAI="1"
GOOGLE_CLOUD_PROJECT="wire-trap-26"
GOOGLE_CLOUD_LOCATION="global"

# Secret Manager & Optional Fallback Keys
# Wiretrap uses Workload Identity / ADC for Vertex AI by default without static keys.
# GEMINI_API_KEY is retained for optional fallback or local development.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

